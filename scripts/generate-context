#!/usr/bin/env bash

# generate-context - Generate .ai-context.yaml for ANY project type
# Usage: ./scripts/generate-context <project-name> [--force]
#
# Supports: Node.js, Python, Go, Rust, Java, .NET, Ruby, PHP, and mixed stacks

# Note: Not using set -e because grep returns 1 when no matches found

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT_DIR="$(dirname "$SCRIPT_DIR")"

# Colors
GREEN='\033[0;32m'
BLUE='\033[0;34m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
MAGENTA='\033[0;35m'
NC='\033[0m'

# Help
if [ -z "$1" ] || [ "$1" = "-h" ] || [ "$1" = "--help" ]; then
    echo "Usage: ./scripts/generate-context <project-name> [--force]"
    echo ""
    echo "Generates .ai-context.yaml with cached project discovery data."
    echo "Works with any technology stack (Node.js, Python, Go, Java, .NET, etc.)"
    echo ""
    echo "Options:"
    echo "  --force    Regenerate even if context file exists"
    echo ""
    echo "Examples:"
    echo "  ./scripts/generate-context prescriber-point"
    echo "  ./scripts/generate-context my-python-api --force"
    exit 0
fi

PROJECT="$1"
FORCE="${2:-}"
PROJECT_PATH="$ROOT_DIR/agent/_projects/$PROJECT"
CONTEXTS_DIR="$ROOT_DIR/.ai-contexts"
CONTEXT_FILE="$CONTEXTS_DIR/$PROJECT.yaml"

# Ensure contexts directory exists
mkdir -p "$CONTEXTS_DIR"

# Special case: workspace itself (ai-dev-agent)
if [ "$PROJECT" = "ai-dev-agent" ]; then
    PROJECT_PATH="$ROOT_DIR"
fi

# Validate project exists
if [ ! -d "$PROJECT_PATH" ]; then
    echo -e "${YELLOW}Error: Project not found at $PROJECT_PATH${NC}"
    echo "Run ./scripts/list-projects to see available projects"
    exit 1
fi

# ============================================
# PRESERVE EXISTING GIT SECTION
# ============================================
EXISTING_GIT_CONFIG=""
if [ -f "$CONTEXT_FILE" ]; then
    # Extract git section if it exists (from "git:" to next top-level key or EOF)
    if grep -q "^git:" "$CONTEXT_FILE" 2>/dev/null; then
        EXISTING_GIT_CONFIG=$(sed -n '/^# ===.*GIT/,/^# ===/p' "$CONTEXT_FILE" | head -n -1)
        # If that didn't work, try simpler extraction
        if [ -z "$EXISTING_GIT_CONFIG" ]; then
            EXISTING_GIT_CONFIG=$(sed -n '/^git:/,/^[a-z]/p' "$CONTEXT_FILE" | head -n -1)
        fi
    fi
fi

# ============================================
# UTILITY FUNCTIONS
# ============================================

file_hash() {
    if [ -f "$1" ]; then
        shasum -a 256 "$1" 2>/dev/null | cut -d' ' -f1
    else
        echo "none"
    fi
}

file_exists() {
    [ -f "$PROJECT_PATH/$1" ]
}

dir_exists() {
    [ -d "$PROJECT_PATH/$1" ]
}

count_files() {
    local dir="$PROJECT_PATH/$1"
    local pattern="$2"
    if [ -d "$dir" ]; then
        find "$dir" -maxdepth 1 -type f -name "$pattern" 2>/dev/null | wc -l | tr -d ' '
    else
        echo "0"
    fi
}

count_dirs() {
    local dir="$PROJECT_PATH/$1"
    if [ -d "$dir" ]; then
        find "$dir" -maxdepth 1 -type d 2>/dev/null | tail -n +2 | wc -l | tr -d ' '
    else
        echo "0"
    fi
}

list_dir_items() {
    local dir="$PROJECT_PATH/$1"
    local pattern="${2:-*}"
    local max="${3:-50}"
    if [ -d "$dir" ]; then
        find "$dir" -maxdepth 1 -type d -name "$pattern" 2>/dev/null | \
            tail -n +2 | xargs -I{} basename {} 2>/dev/null | sort | head -n "$max"
    fi
}

list_files() {
    local dir="$PROJECT_PATH/$1"
    local pattern="${2:-*.ts}"
    local max="${3:-50}"
    if [ -d "$dir" ]; then
        find "$dir" -maxdepth 1 -type f -name "$pattern" 2>/dev/null | \
            xargs -I{} basename {} 2>/dev/null | sed 's/\.[^.]*$//' | sort | head -n "$max"
    fi
}

grep_json_value() {
    local file="$1"
    local key="$2"
    grep -o "\"$key\"[[:space:]]*:[[:space:]]*\"[^\"]*\"" "$file" 2>/dev/null | head -1 | sed 's/.*: *"\([^"]*\)".*/\1/'
}

has_dependency() {
    local file="$1"
    local dep="$2"
    grep -q "\"$dep\"" "$file" 2>/dev/null
}

get_version() {
    local file="$1"
    local dep="$2"
    grep "\"$dep\"" "$file" 2>/dev/null | head -1 | sed 's/.*: *"\([^"]*\)".*/\1/' | tr -d '^~>='
}

# ============================================
# LANGUAGE/STACK DETECTION
# ============================================

DETECTED_LANGUAGES=""
DETECTED_STACKS=""
PRIMARY_LANGUAGE=""
PRIMARY_STACK=""

detect_languages() {
    # Node.js / JavaScript / TypeScript
    if file_exists "package.json"; then
        DETECTED_LANGUAGES="$DETECTED_LANGUAGES nodejs"
        if file_exists "tsconfig.json"; then
            DETECTED_LANGUAGES="$DETECTED_LANGUAGES typescript"
            PRIMARY_LANGUAGE="typescript"
        else
            PRIMARY_LANGUAGE="javascript"
        fi
    fi

    # Python
    if file_exists "requirements.txt" || file_exists "pyproject.toml" || file_exists "setup.py" || file_exists "Pipfile"; then
        DETECTED_LANGUAGES="$DETECTED_LANGUAGES python"
        [ -z "$PRIMARY_LANGUAGE" ] && PRIMARY_LANGUAGE="python"
    fi

    # Go
    if file_exists "go.mod" || file_exists "go.sum"; then
        DETECTED_LANGUAGES="$DETECTED_LANGUAGES go"
        [ -z "$PRIMARY_LANGUAGE" ] && PRIMARY_LANGUAGE="go"
    fi

    # Rust
    if file_exists "Cargo.toml"; then
        DETECTED_LANGUAGES="$DETECTED_LANGUAGES rust"
        [ -z "$PRIMARY_LANGUAGE" ] && PRIMARY_LANGUAGE="rust"
    fi

    # Java / Kotlin
    if file_exists "pom.xml" || file_exists "build.gradle" || file_exists "build.gradle.kts"; then
        DETECTED_LANGUAGES="$DETECTED_LANGUAGES java"
        [ -z "$PRIMARY_LANGUAGE" ] && PRIMARY_LANGUAGE="java"
        if file_exists "build.gradle.kts" || find "$PROJECT_PATH" -name "*.kt" -type f 2>/dev/null | head -1 | grep -q .; then
            DETECTED_LANGUAGES="$DETECTED_LANGUAGES kotlin"
        fi
    fi

    # .NET / C#
    if ls "$PROJECT_PATH"/*.sln "$PROJECT_PATH"/*.csproj 2>/dev/null | head -1 | grep -q . || \
       find "$PROJECT_PATH" -maxdepth 3 -name "*.csproj" 2>/dev/null | head -1 | grep -q .; then
        DETECTED_LANGUAGES="$DETECTED_LANGUAGES csharp dotnet"
        [ -z "$PRIMARY_LANGUAGE" ] && PRIMARY_LANGUAGE="csharp"
    fi

    # Ruby
    if file_exists "Gemfile"; then
        DETECTED_LANGUAGES="$DETECTED_LANGUAGES ruby"
        [ -z "$PRIMARY_LANGUAGE" ] && PRIMARY_LANGUAGE="ruby"
    fi

    # PHP
    if file_exists "composer.json"; then
        DETECTED_LANGUAGES="$DETECTED_LANGUAGES php"
        [ -z "$PRIMARY_LANGUAGE" ] && PRIMARY_LANGUAGE="php"
    fi

    # Default
    [ -z "$PRIMARY_LANGUAGE" ] && PRIMARY_LANGUAGE="unknown"
}

detect_frameworks() {
    # ===== FRONTEND FRAMEWORKS =====
    if file_exists "package.json"; then
        PKG="$PROJECT_PATH/package.json"

        # React ecosystem
        if has_dependency "$PKG" "next"; then
            DETECTED_STACKS="$DETECTED_STACKS next"
            PRIMARY_STACK="next"
        elif has_dependency "$PKG" "react"; then
            DETECTED_STACKS="$DETECTED_STACKS react"
            [ -z "$PRIMARY_STACK" ] && PRIMARY_STACK="react"
        fi

        # Vue ecosystem
        if has_dependency "$PKG" "nuxt"; then
            DETECTED_STACKS="$DETECTED_STACKS nuxt"
            [ -z "$PRIMARY_STACK" ] && PRIMARY_STACK="nuxt"
        elif has_dependency "$PKG" "vue"; then
            DETECTED_STACKS="$DETECTED_STACKS vue"
            [ -z "$PRIMARY_STACK" ] && PRIMARY_STACK="vue"
        fi

        # Angular
        if has_dependency "$PKG" "@angular/core"; then
            DETECTED_STACKS="$DETECTED_STACKS angular"
            [ -z "$PRIMARY_STACK" ] && PRIMARY_STACK="angular"
        fi

        # Svelte
        if has_dependency "$PKG" "svelte"; then
            DETECTED_STACKS="$DETECTED_STACKS svelte"
            [ -z "$PRIMARY_STACK" ] && PRIMARY_STACK="svelte"
        fi

        # Node.js backends
        if has_dependency "$PKG" "express"; then
            DETECTED_STACKS="$DETECTED_STACKS express"
            [ -z "$PRIMARY_STACK" ] && PRIMARY_STACK="express"
        fi
        if has_dependency "$PKG" "fastify"; then
            DETECTED_STACKS="$DETECTED_STACKS fastify"
        fi
        if has_dependency "$PKG" "nestjs" || has_dependency "$PKG" "@nestjs/core"; then
            DETECTED_STACKS="$DETECTED_STACKS nestjs"
            [ -z "$PRIMARY_STACK" ] && PRIMARY_STACK="nestjs"
        fi
        if has_dependency "$PKG" "hono"; then
            DETECTED_STACKS="$DETECTED_STACKS hono"
        fi
    fi

    # ===== PYTHON FRAMEWORKS =====
    if file_exists "requirements.txt"; then
        REQ="$PROJECT_PATH/requirements.txt"
        grep -qi "django" "$REQ" 2>/dev/null && DETECTED_STACKS="$DETECTED_STACKS django"
        grep -qi "flask" "$REQ" 2>/dev/null && DETECTED_STACKS="$DETECTED_STACKS flask"
        grep -qi "fastapi" "$REQ" 2>/dev/null && DETECTED_STACKS="$DETECTED_STACKS fastapi"
        grep -qi "sqlalchemy" "$REQ" 2>/dev/null && DETECTED_STACKS="$DETECTED_STACKS sqlalchemy"
    fi
    if file_exists "pyproject.toml"; then
        PYPROJ="$PROJECT_PATH/pyproject.toml"
        grep -qi "django" "$PYPROJ" 2>/dev/null && DETECTED_STACKS="$DETECTED_STACKS django"
        grep -qi "flask" "$PYPROJ" 2>/dev/null && DETECTED_STACKS="$DETECTED_STACKS flask"
        grep -qi "fastapi" "$PYPROJ" 2>/dev/null && DETECTED_STACKS="$DETECTED_STACKS fastapi"
    fi

    # ===== GO FRAMEWORKS =====
    if file_exists "go.mod"; then
        GOMOD="$PROJECT_PATH/go.mod"
        grep -q "gin-gonic" "$GOMOD" 2>/dev/null && DETECTED_STACKS="$DETECTED_STACKS gin"
        grep -q "labstack/echo" "$GOMOD" 2>/dev/null && DETECTED_STACKS="$DETECTED_STACKS echo"
        grep -q "gofiber" "$GOMOD" 2>/dev/null && DETECTED_STACKS="$DETECTED_STACKS fiber"
        grep -q "go-chi" "$GOMOD" 2>/dev/null && DETECTED_STACKS="$DETECTED_STACKS chi"
    fi

    # ===== JAVA FRAMEWORKS =====
    if file_exists "pom.xml"; then
        POM="$PROJECT_PATH/pom.xml"
        grep -q "spring-boot" "$POM" 2>/dev/null && DETECTED_STACKS="$DETECTED_STACKS spring-boot"
        grep -q "quarkus" "$POM" 2>/dev/null && DETECTED_STACKS="$DETECTED_STACKS quarkus"
    fi
    if file_exists "build.gradle" || file_exists "build.gradle.kts"; then
        GRADLE="$PROJECT_PATH/build.gradle"
        [ -f "$PROJECT_PATH/build.gradle.kts" ] && GRADLE="$PROJECT_PATH/build.gradle.kts"
        grep -q "spring" "$GRADLE" 2>/dev/null && DETECTED_STACKS="$DETECTED_STACKS spring-boot"
        grep -q "ktor" "$GRADLE" 2>/dev/null && DETECTED_STACKS="$DETECTED_STACKS ktor"
    fi

    # ===== RUBY FRAMEWORKS =====
    if file_exists "Gemfile"; then
        GEMFILE="$PROJECT_PATH/Gemfile"
        grep -q "rails" "$GEMFILE" 2>/dev/null && DETECTED_STACKS="$DETECTED_STACKS rails"
        grep -q "sinatra" "$GEMFILE" 2>/dev/null && DETECTED_STACKS="$DETECTED_STACKS sinatra"
    fi

    # ===== PHP FRAMEWORKS =====
    if file_exists "composer.json"; then
        COMPOSER="$PROJECT_PATH/composer.json"
        grep -q "laravel" "$COMPOSER" 2>/dev/null && DETECTED_STACKS="$DETECTED_STACKS laravel"
        grep -q "symfony" "$COMPOSER" 2>/dev/null && DETECTED_STACKS="$DETECTED_STACKS symfony"
    fi

    # ===== .NET FRAMEWORKS =====
    CSPROJ=$(find "$PROJECT_PATH" -maxdepth 3 -name "*.csproj" 2>/dev/null | head -1)
    if [ -n "$CSPROJ" ]; then
        grep -q "Microsoft.AspNetCore" "$CSPROJ" 2>/dev/null && DETECTED_STACKS="$DETECTED_STACKS aspnet"
        grep -q "Microsoft.NET.Sdk.Web" "$CSPROJ" 2>/dev/null && DETECTED_STACKS="$DETECTED_STACKS aspnet"
        [ -z "$DETECTED_STACKS" ] && DETECTED_STACKS="$DETECTED_STACKS dotnet"
    fi

    # ===== RUST FRAMEWORKS =====
    if file_exists "Cargo.toml"; then
        CARGO="$PROJECT_PATH/Cargo.toml"
        grep -q "actix-web" "$CARGO" 2>/dev/null && DETECTED_STACKS="$DETECTED_STACKS actix"
        grep -q "axum" "$CARGO" 2>/dev/null && DETECTED_STACKS="$DETECTED_STACKS axum"
        grep -q "rocket" "$CARGO" 2>/dev/null && DETECTED_STACKS="$DETECTED_STACKS rocket"
    fi
}

# ============================================
# UI LIBRARY DETECTION (Frontend)
# ============================================

detect_ui_library() {
    UI_LIBRARY="none"
    UI_VERSION=""

    if file_exists "package.json"; then
        PKG="$PROJECT_PATH/package.json"

        if has_dependency "$PKG" "@prescriberpoint/ui"; then
            UI_LIBRARY="@prescriberpoint/ui"
            UI_VERSION=$(get_version "$PKG" "@prescriberpoint/ui")
        elif has_dependency "$PKG" "antd"; then
            UI_LIBRARY="antd"
            UI_VERSION=$(get_version "$PKG" "antd")
        elif has_dependency "$PKG" "@mui/material"; then
            UI_LIBRARY="@mui/material"
            UI_VERSION=$(get_version "$PKG" "@mui/material")
        elif has_dependency "$PKG" "@chakra-ui/react"; then
            UI_LIBRARY="@chakra-ui/react"
            UI_VERSION=$(get_version "$PKG" "@chakra-ui/react")
        elif has_dependency "$PKG" "@mantine/core"; then
            UI_LIBRARY="@mantine/core"
            UI_VERSION=$(get_version "$PKG" "@mantine/core")
        elif has_dependency "$PKG" "@headlessui/react"; then
            UI_LIBRARY="@headlessui/react"
            UI_VERSION=$(get_version "$PKG" "@headlessui/react")
        fi
    fi
}

# ============================================
# DATABASE DETECTION
# ============================================

detect_database() {
    DATABASE=""
    ORM=""

    # Node.js
    if file_exists "package.json"; then
        PKG="$PROJECT_PATH/package.json"
        has_dependency "$PKG" "pg" && DATABASE="$DATABASE postgresql"
        has_dependency "$PKG" "mysql2" && DATABASE="$DATABASE mysql"
        has_dependency "$PKG" "mongodb" && DATABASE="$DATABASE mongodb"
        has_dependency "$PKG" "@azure/cosmos" && DATABASE="$DATABASE cosmosdb"
        has_dependency "$PKG" "redis" || has_dependency "$PKG" "ioredis" && DATABASE="$DATABASE redis"
        has_dependency "$PKG" "prisma" && ORM="prisma"
        has_dependency "$PKG" "drizzle-orm" && ORM="drizzle"
        has_dependency "$PKG" "typeorm" && ORM="typeorm"
        has_dependency "$PKG" "sequelize" && ORM="sequelize"
        has_dependency "$PKG" "mongoose" && ORM="mongoose"
    fi

    # Python
    if file_exists "requirements.txt"; then
        REQ="$PROJECT_PATH/requirements.txt"
        grep -qi "psycopg" "$REQ" 2>/dev/null && DATABASE="$DATABASE postgresql"
        grep -qi "pymysql" "$REQ" 2>/dev/null && DATABASE="$DATABASE mysql"
        grep -qi "pymongo" "$REQ" 2>/dev/null && DATABASE="$DATABASE mongodb"
        grep -qi "sqlalchemy" "$REQ" 2>/dev/null && ORM="sqlalchemy"
        grep -qi "django" "$REQ" 2>/dev/null && ORM="django-orm"
    fi

    # Go
    if file_exists "go.mod"; then
        GOMOD="$PROJECT_PATH/go.mod"
        grep -q "lib/pq" "$GOMOD" 2>/dev/null && DATABASE="$DATABASE postgresql"
        grep -q "go-sql-driver" "$GOMOD" 2>/dev/null && DATABASE="$DATABASE mysql"
        grep -q "mongo-driver" "$GOMOD" 2>/dev/null && DATABASE="$DATABASE mongodb"
        grep -q "gorm" "$GOMOD" 2>/dev/null && ORM="gorm"
    fi

    DATABASE=$(echo "$DATABASE" | xargs)  # trim
}

# ============================================
# TESTING DETECTION
# ============================================

detect_testing() {
    UNIT_TEST=""
    E2E_TEST=""
    INT_TEST=""

    # Node.js
    if file_exists "package.json"; then
        PKG="$PROJECT_PATH/package.json"
        has_dependency "$PKG" "jest" && UNIT_TEST="jest"
        has_dependency "$PKG" "vitest" && UNIT_TEST="vitest"
        has_dependency "$PKG" "mocha" && UNIT_TEST="mocha"
        has_dependency "$PKG" "cypress" && E2E_TEST="cypress"
        has_dependency "$PKG" "playwright" && E2E_TEST="playwright"
        has_dependency "$PKG" "@playwright/test" && E2E_TEST="playwright"
    fi

    # Python
    if file_exists "requirements.txt" || file_exists "pyproject.toml"; then
        [ -d "$PROJECT_PATH/tests" ] || [ -d "$PROJECT_PATH/test" ] && UNIT_TEST="pytest"
    fi

    # Go
    [ -n "$(find "$PROJECT_PATH" -name "*_test.go" -type f 2>/dev/null | head -1)" ] && UNIT_TEST="go-test"

    # Java
    [ -d "$PROJECT_PATH/src/test" ] && UNIT_TEST="junit"

    # Ruby
    [ -d "$PROJECT_PATH/spec" ] && UNIT_TEST="rspec"
}

# ============================================
# DIRECTORY STRUCTURE SCANNING
# ============================================

scan_directory_structure() {
    COMPONENTS_DIR=""
    HOOKS_DIR=""
    UTILS_DIR=""
    SERVICES_DIR=""
    API_DIR=""
    MODELS_DIR=""
    CONTROLLERS_DIR=""

    # Frontend patterns
    for d in "components" "src/components" "app/components" "lib/components"; do
        dir_exists "$d" && COMPONENTS_DIR="$d" && break
    done

    for d in "hooks" "src/hooks" "app/hooks" "lib/hooks" "composables" "src/composables"; do
        dir_exists "$d" && HOOKS_DIR="$d" && break
    done

    # Shared patterns
    for d in "utils" "src/utils" "lib/utils" "helpers" "src/helpers" "pkg/utils"; do
        dir_exists "$d" && UTILS_DIR="$d" && break
    done

    for d in "services" "src/services" "app/services" "internal/services" "pkg/services"; do
        dir_exists "$d" && SERVICES_DIR="$d" && break
    done

    # API patterns
    for d in "app/api" "api" "src/api" "routes" "src/routes" "internal/api" "cmd/api"; do
        dir_exists "$d" && API_DIR="$d" && break
    done

    # Models/Entities
    for d in "models" "src/models" "entities" "src/entities" "internal/models" "domain"; do
        dir_exists "$d" && MODELS_DIR="$d" && break
    done

    # Controllers (backend)
    for d in "controllers" "src/controllers" "internal/handlers" "handlers" "app/controllers"; do
        dir_exists "$d" && CONTROLLERS_DIR="$d" && break
    done
}

# ============================================
# MAIN EXECUTION
# ============================================

echo -e "${BLUE}Analyzing project: ${CYAN}$PROJECT${NC}"
echo ""

# Run all detections
detect_languages
detect_frameworks
detect_ui_library
detect_database
detect_testing
scan_directory_structure

# Get file hashes
HASH_PKG=$(file_hash "$PROJECT_PATH/package.json")
HASH_REQ=$(file_hash "$PROJECT_PATH/requirements.txt")
HASH_GOMOD=$(file_hash "$PROJECT_PATH/go.mod")
HASH_CARGO=$(file_hash "$PROJECT_PATH/Cargo.toml")
HASH_TSCONFIG=$(file_hash "$PROJECT_PATH/tsconfig.json")
HASH_TAILWIND=$(file_hash "$PROJECT_PATH/tailwind.config.js")
[ "$HASH_TAILWIND" = "none" ] && HASH_TAILWIND=$(file_hash "$PROJECT_PATH/tailwind.config.ts")

# Count items
COMP_COUNT=$(count_dirs "$COMPONENTS_DIR")
HOOKS_COUNT=$(count_files "$HOOKS_DIR" "use*.ts*")
[ "$HOOKS_COUNT" -eq 0 ] && HOOKS_COUNT=$(count_files "$HOOKS_DIR" "*.ts")
UTILS_COUNT=$(count_files "$UTILS_DIR" "*.ts")
[ "$UTILS_COUNT" -eq 0 ] && UTILS_COUNT=$(count_files "$UTILS_DIR" "*.py")
[ "$UTILS_COUNT" -eq 0 ] && UTILS_COUNT=$(count_files "$UTILS_DIR" "*.go")
SERVICES_COUNT=$(count_files "$SERVICES_DIR" "*")
MODELS_COUNT=$(count_files "$MODELS_DIR" "*")

TIMESTAMP=$(date -u +%Y-%m-%dT%H:%M:%SZ)

# ============================================
# DETECT PACKAGE MANAGER & SCRIPTS
# ============================================

detect_package_manager() {
    PKG_MANAGER="npm"
    RUN_CMD="npm run"

    if file_exists "pnpm-lock.yaml"; then
        PKG_MANAGER="pnpm"
        RUN_CMD="pnpm"
    elif file_exists "yarn.lock"; then
        PKG_MANAGER="yarn"
        RUN_CMD="yarn"
    elif file_exists "bun.lockb"; then
        PKG_MANAGER="bun"
        RUN_CMD="bun run"
    fi
}

detect_scripts() {
    BUILD_CMD=""
    DEV_CMD=""
    TEST_CMD=""
    LINT_CMD=""

    if file_exists "package.json"; then
        PKG="$PROJECT_PATH/package.json"
        grep -q '"build"' "$PKG" 2>/dev/null && BUILD_CMD="$RUN_CMD build"
        grep -q '"dev"' "$PKG" 2>/dev/null && DEV_CMD="$RUN_CMD dev"
        grep -q '"start"' "$PKG" 2>/dev/null && [ -z "$DEV_CMD" ] && DEV_CMD="$RUN_CMD start"
        grep -q '"test"' "$PKG" 2>/dev/null && TEST_CMD="$RUN_CMD test"
        grep -q '"lint"' "$PKG" 2>/dev/null && LINT_CMD="$RUN_CMD lint"
    elif file_exists "Makefile"; then
        grep -q '^build:' "$PROJECT_PATH/Makefile" 2>/dev/null && BUILD_CMD="make build"
        grep -q '^dev:' "$PROJECT_PATH/Makefile" 2>/dev/null && DEV_CMD="make dev"
        grep -q '^test:' "$PROJECT_PATH/Makefile" 2>/dev/null && TEST_CMD="make test"
        grep -q '^lint:' "$PROJECT_PATH/Makefile" 2>/dev/null && LINT_CMD="make lint"
    fi

    # Python defaults
    if [ "$PRIMARY_LANGUAGE" = "python" ]; then
        [ -z "$TEST_CMD" ] && [ -d "$PROJECT_PATH/tests" ] && TEST_CMD="pytest"
        [ -z "$LINT_CMD" ] && TEST_CMD="ruff check . || black --check ."
    fi

    # Go defaults
    if [ "$PRIMARY_LANGUAGE" = "go" ]; then
        [ -z "$BUILD_CMD" ] && BUILD_CMD="go build ./..."
        [ -z "$TEST_CMD" ] && TEST_CMD="go test ./..."
    fi
}

detect_package_manager
detect_scripts

# ============================================
# EXTRACT PROJECT INFO FROM README
# ============================================

extract_project_description() {
    PROJECT_DESCRIPTION=""
    PROJECT_PURPOSE=""

    for readme in "README.md" "readme.md" "README.rst" "README"; do
        if file_exists "$readme"; then
            # Get first meaningful paragraph (skip headers, badges, empty lines)
            PROJECT_DESCRIPTION=$(grep -v '^#' "$PROJECT_PATH/$readme" 2>/dev/null | grep -v '^\[' | grep -v '^<' | grep -v '^$' | head -1 | head -c 200)
            break
        fi
    done

    # Fallback to package.json description
    if [ -z "$PROJECT_DESCRIPTION" ] && file_exists "package.json"; then
        PROJECT_DESCRIPTION=$(grep_json_value "$PROJECT_PATH/package.json" "description")
    fi
}

extract_project_description

# ============================================
# GENERATE YAML - NEW STRUCTURE
# ============================================

cat > "$CONTEXT_FILE" << YAML
# ============================================
# AI PROJECT CONTEXT
# Auto-generated - Do not edit manually
# Regenerate: ./scripts/generate-context $PROJECT
# ============================================
# Structure: product | structure | tech (consolidated for token efficiency)
# ============================================

version: "2.0"
generated: "$TIMESTAMP"
project: "$PROJECT"

# ============================================
# CACHE INVALIDATION
# ============================================
watched_files:
YAML

[ "$HASH_PKG" != "none" ] && echo "  package.json: \"$HASH_PKG\"" >> "$CONTEXT_FILE"
[ "$HASH_REQ" != "none" ] && echo "  requirements.txt: \"$HASH_REQ\"" >> "$CONTEXT_FILE"
[ "$HASH_GOMOD" != "none" ] && echo "  go.mod: \"$HASH_GOMOD\"" >> "$CONTEXT_FILE"
[ "$HASH_CARGO" != "none" ] && echo "  Cargo.toml: \"$HASH_CARGO\"" >> "$CONTEXT_FILE"
[ "$HASH_TSCONFIG" != "none" ] && echo "  tsconfig.json: \"$HASH_TSCONFIG\"" >> "$CONTEXT_FILE"
[ "$HASH_TAILWIND" != "none" ] && echo "  tailwind.config: \"$HASH_TAILWIND\"" >> "$CONTEXT_FILE"

# ============================================
# PRODUCT SECTION
# ============================================

cat >> "$CONTEXT_FILE" << YAML

# ============================================
# PRODUCT
# Defines project goals, user expectations, core behavior
# ============================================
product:
  name: "$PROJECT"
YAML

[ -n "$PROJECT_DESCRIPTION" ] && echo "  description: \"$(echo "$PROJECT_DESCRIPTION" | tr '\n' ' ' | sed 's/"/\\"/g')\"" >> "$CONTEXT_FILE"

cat >> "$CONTEXT_FILE" << YAML
  type: "$([ -n "$(echo $DETECTED_STACKS | grep -E 'next|nuxt|react|vue|angular|svelte')" ] && echo "frontend" || echo "backend")"
YAML

# Core behaviors based on detected patterns
echo "  core_behaviors:" >> "$CONTEXT_FILE"
[ -n "$(echo $DETECTED_STACKS | grep -E 'next|nuxt')" ] && echo "    - \"Server-side rendered application\"" >> "$CONTEXT_FILE"
[ -n "$(echo $DETECTED_STACKS | grep -E 'express|fastify|nestjs|flask|fastapi|gin|spring')" ] && echo "    - \"API service\"" >> "$CONTEXT_FILE"
[ -n "$DATABASE" ] && echo "    - \"Data persistence with $DATABASE\"" >> "$CONTEXT_FILE"
[ -n "$(echo $DETECTED_STACKS | grep -E 'react|vue|angular|svelte')" ] && echo "    - \"Component-based UI\"" >> "$CONTEXT_FILE"

# ============================================
# STRUCTURE SECTION
# ============================================

cat >> "$CONTEXT_FILE" << YAML

# ============================================
# STRUCTURE
# Folder layouts, file organization, architecture
# ============================================
structure:
  directories:
YAML

[ -n "$COMPONENTS_DIR" ] && echo "    components: \"$COMPONENTS_DIR\"" >> "$CONTEXT_FILE"
[ -n "$HOOKS_DIR" ] && echo "    hooks: \"$HOOKS_DIR\"" >> "$CONTEXT_FILE"
[ -n "$UTILS_DIR" ] && echo "    utils: \"$UTILS_DIR\"" >> "$CONTEXT_FILE"
[ -n "$SERVICES_DIR" ] && echo "    services: \"$SERVICES_DIR\"" >> "$CONTEXT_FILE"
[ -n "$API_DIR" ] && echo "    api: \"$API_DIR\"" >> "$CONTEXT_FILE"
[ -n "$MODELS_DIR" ] && echo "    models: \"$MODELS_DIR\"" >> "$CONTEXT_FILE"
[ -n "$CONTROLLERS_DIR" ] && echo "    controllers: \"$CONTROLLERS_DIR\"" >> "$CONTEXT_FILE"

cat >> "$CONTEXT_FILE" << YAML

  stats:
    components: $COMP_COUNT
    hooks: $HOOKS_COUNT
    utils: $UTILS_COUNT
    services: $SERVICES_COUNT
    models: $MODELS_COUNT
YAML

# Discovered items (collapsed into structure)
if [ -n "$COMPONENTS_DIR" ] && [ "$COMP_COUNT" -gt 0 ]; then
    echo "" >> "$CONTEXT_FILE"
    echo "  discovered_components:" >> "$CONTEXT_FILE"
    list_dir_items "$COMPONENTS_DIR" '[A-Z]*' 30 | while read -r item; do
        [ -n "$item" ] && echo "    - \"$item\""
    done >> "$CONTEXT_FILE"
fi

if [ -n "$HOOKS_DIR" ] && [ "$HOOKS_COUNT" -gt 0 ]; then
    echo "" >> "$CONTEXT_FILE"
    echo "  discovered_hooks:" >> "$CONTEXT_FILE"
    list_files "$HOOKS_DIR" "use*.ts*" 20 | while read -r item; do
        [ -n "$item" ] && echo "    - \"$item\""
    done >> "$CONTEXT_FILE"
fi

if [ -n "$SERVICES_DIR" ] && [ "$SERVICES_COUNT" -gt 0 ]; then
    echo "" >> "$CONTEXT_FILE"
    echo "  discovered_services:" >> "$CONTEXT_FILE"
    for ext in "*.ts" "*.py" "*.go"; do
        list_files "$SERVICES_DIR" "$ext" 15 | while read -r item; do
            [ -n "$item" ] && echo "    - \"$item\""
        done >> "$CONTEXT_FILE"
    done
fi

# ============================================
# TECH SECTION
# ============================================

cat >> "$CONTEXT_FILE" << YAML

# ============================================
# TECH
# Technology stack, tools, commands
# ============================================
tech:
  language: "$PRIMARY_LANGUAGE"
  languages: [$(echo $DETECTED_LANGUAGES | tr ' ' ',' | sed 's/,/, /g')]
  frameworks: [$(echo $DETECTED_STACKS | tr ' ' ',' | sed 's/,/, /g')]
YAML

[ -n "$DATABASE" ] && echo "  databases: [$(echo $DATABASE | tr ' ' ',' | sed 's/,/, /g')]" >> "$CONTEXT_FILE"
[ -n "$ORM" ] && echo "  orm: \"$ORM\"" >> "$CONTEXT_FILE"

cat >> "$CONTEXT_FILE" << YAML

  testing:
    unit: "$UNIT_TEST"
    e2e: "$E2E_TEST"

  commands:
    package_manager: "$PKG_MANAGER"
YAML

[ -n "$DEV_CMD" ] && echo "    dev: \"$DEV_CMD\"" >> "$CONTEXT_FILE"
[ -n "$BUILD_CMD" ] && echo "    build: \"$BUILD_CMD\"" >> "$CONTEXT_FILE"
[ -n "$TEST_CMD" ] && echo "    test: \"$TEST_CMD\"" >> "$CONTEXT_FILE"
[ -n "$LINT_CMD" ] && echo "    lint: \"$LINT_CMD\"" >> "$CONTEXT_FILE"

# UI Library section (if frontend)
if [ "$UI_LIBRARY" != "none" ]; then
    cat >> "$CONTEXT_FILE" << YAML

  ui_library:
    name: "$UI_LIBRARY"
    version: "$UI_VERSION"
    import: "import { Component } from '$UI_LIBRARY'"
YAML

    # Analyze usage if applicable
    if [ -d "$PROJECT_PATH/components" ] || [ -d "$PROJECT_PATH/app" ] || [ -d "$PROJECT_PATH/src" ]; then
        echo "    common_components:" >> "$CONTEXT_FILE"
        grep -rh "from ['\"]$UI_LIBRARY['\"]" "$PROJECT_PATH/components" "$PROJECT_PATH/app" "$PROJECT_PATH/src" 2>/dev/null | \
            sed "s/.*import {//" | sed 's/}.*//' | tr ',' '\n' | \
            sed 's/^ *//' | sed 's/ *$//' | grep -v '^$' | grep -v '^type ' | \
            sort | uniq -c | sort -rn | head -10 | while read -r count name; do
            [ -n "$name" ] && echo "      - \"$name\""
        done >> "$CONTEXT_FILE"
    fi
fi

# ============================================
# DEVELOPER RULES
# ============================================

cat >> "$CONTEXT_FILE" << YAML

# ============================================
# DEVELOPER RULES
# Critical rules AI must follow
# ============================================
rules:
YAML

if [ "$UI_LIBRARY" != "none" ]; then
    echo "  - \"ALWAYS use $UI_LIBRARY components, NOT raw HTML\"" >> "$CONTEXT_FILE"
fi

cat >> "$CONTEXT_FILE" << YAML
  - "Reuse existing components from discovered_components"
  - "Follow patterns in existing code"
  - "Check discovered_services before creating new ones"
YAML

# ============================================
# RESTORE GIT CONFIGURATION
# ============================================
if [ -n "$EXISTING_GIT_CONFIG" ]; then
    echo "" >> "$CONTEXT_FILE"
    echo "$EXISTING_GIT_CONFIG" >> "$CONTEXT_FILE"
fi

# ============================================
# OUTPUT SUMMARY
# ============================================

echo -e "${GREEN}Context generated successfully!${NC}"
echo ""
echo -e "${BLUE}Tech Stack:${NC}"
echo "  Language:   $PRIMARY_LANGUAGE"
echo "  Frameworks: $(echo $DETECTED_STACKS | tr ' ' ', ')"
[ -n "$DATABASE" ] && echo "  Database:   $DATABASE"
[ -n "$ORM" ] && echo "  ORM:        $ORM"
[ "$UI_LIBRARY" != "none" ] && echo "  UI Library: $UI_LIBRARY ($UI_VERSION)"
echo ""
echo -e "${BLUE}Structure:${NC}"
[ -n "$COMPONENTS_DIR" ] && echo "  Components: $COMP_COUNT in $COMPONENTS_DIR/"
[ -n "$HOOKS_DIR" ] && echo "  Hooks:      $HOOKS_COUNT in $HOOKS_DIR/"
[ -n "$SERVICES_DIR" ] && echo "  Services:   $SERVICES_COUNT in $SERVICES_DIR/"
[ -n "$UTILS_DIR" ] && echo "  Utils:      $UTILS_COUNT in $UTILS_DIR/"
[ -n "$MODELS_DIR" ] && echo "  Models:     $MODELS_COUNT in $MODELS_DIR/"
echo ""
echo -e "${MAGENTA}Output:${NC} $CONTEXT_FILE"
