#!/usr/bin/env bash

# session-stats — On-demand report of current Claude Code session state
#
# Reads per-session sidecars at .ai-session/by-id/*.json and prints a summary.
# By default shows the most recently active session. Use --all to list every
# active sidecar, --session-id to target a specific one.
#
# Usage:
#   ./scripts/session-stats                    # most recent session
#   ./scripts/session-stats --all              # list all active sessions
#   ./scripts/session-stats --session-id <id>  # specific session
#   ./scripts/session-stats --json             # machine-readable
#   ./scripts/session-stats --cleanup          # remove sidecars older than 7d now
#
# The sidecar is populated by scripts/hooks/inject-context.sh on every
# UserPromptSubmit. It tracks: prompts, started_at, last_active, cwd, project.

set -uo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT_DIR="$(dirname "$SCRIPT_DIR")"
SIDECAR_DIR="$ROOT_DIR/.ai-session/by-id"

GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
DIM='\033[2m'
NC='\033[0m'

MODE="latest"
SESSION_ID=""
JSON_OUT=false

while [ $# -gt 0 ]; do
  case "$1" in
    --all) MODE="all"; shift ;;
    --session-id) MODE="specific"; SESSION_ID="$2"; shift 2 ;;
    --json) JSON_OUT=true; shift ;;
    --cleanup)
      find "$SIDECAR_DIR" -maxdepth 1 -name "*.json" -mtime +7 -delete 2>/dev/null || true
      echo "Removed sidecars older than 7 days."
      exit 0
      ;;
    -h|--help)
      sed -n '3,19p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "Unknown option: $1" >&2; exit 1 ;;
  esac
done

if [ ! -d "$SIDECAR_DIR" ]; then
  echo "No sessions tracked yet. Sidecars are created on the first UserPromptSubmit hook."
  exit 0
fi

SIDECARS=()
while IFS= read -r -d '' f; do SIDECARS+=("$f"); done < <(find "$SIDECAR_DIR" -maxdepth 1 -name "*.json" -print0 2>/dev/null)
if [ ${#SIDECARS[@]} -eq 0 ]; then
  echo "No active session sidecars in $SIDECAR_DIR"
  exit 0
fi

# ─── Select targets ─────────────────────────────────────────
TARGETS=()
case "$MODE" in
  latest)
    # Pick most recent by mtime
    latest=$(ls -t "$SIDECAR_DIR"/*.json 2>/dev/null | head -1)
    [ -n "$latest" ] && TARGETS+=("$latest")
    ;;
  all)
    # Sort by mtime descending
    while IFS= read -r f; do TARGETS+=("$f"); done < <(ls -t "$SIDECAR_DIR"/*.json 2>/dev/null)
    ;;
  specific)
    f="$SIDECAR_DIR/${SESSION_ID}.json"
    if [ ! -f "$f" ]; then
      echo "No sidecar for session_id: $SESSION_ID" >&2
      exit 1
    fi
    TARGETS+=("$f")
    ;;
esac

# ─── JSON mode: dump raw ────────────────────────────────────
if [ "$JSON_OUT" = true ]; then
  if [ ${#TARGETS[@]} -eq 1 ]; then
    cat "${TARGETS[0]}"
  else
    jq -s '.' "${TARGETS[@]}"
  fi
  exit 0
fi

# ─── Human-readable ─────────────────────────────────────────
format_duration() {
  local start="$1" end="$2"
  # ISO8601 UTC to epoch; portable between macOS/Linux
  local s e
  if date -j -f "%Y-%m-%dT%H:%M:%SZ" "$start" +%s >/dev/null 2>&1; then
    s=$(date -j -f "%Y-%m-%dT%H:%M:%SZ" "$start" +%s)
    e=$(date -j -f "%Y-%m-%dT%H:%M:%SZ" "$end" +%s)
  else
    s=$(date -d "$start" +%s)
    e=$(date -d "$end" +%s)
  fi
  local diff=$((e - s))
  if [ "$diff" -lt 60 ]; then echo "${diff}s"
  elif [ "$diff" -lt 3600 ]; then echo "$((diff / 60))m"
  else echo "$((diff / 3600))h $(((diff % 3600) / 60))m"
  fi
}

NOW=$(date -u +%Y-%m-%dT%H:%M:%SZ)

for sidecar in "${TARGETS[@]}"; do
  id=$(jq -r '.session_id // "?"' "$sidecar")
  started=$(jq -r '.started_at // "?"' "$sidecar")
  last=$(jq -r '.last_active // "?"' "$sidecar")
  cwd=$(jq -r '.cwd // "-"' "$sidecar")
  project=$(jq -r '.project // "-"' "$sidecar")
  prompts=$(jq -r '.prompts // 0' "$sidecar")
  lessons=$(jq -r '(.lessons_captured // []) | length' "$sidecar")
  files=$(jq -r '(.files_touched // []) | length' "$sidecar")
  cost=$(jq -r '.cost_usd // 0' "$sidecar")
  dur_ms=$(jq -r '.duration_ms // 0' "$sidecar")
  la=$(jq -r '.lines_added // 0' "$sidecar")
  lr=$(jq -r '.lines_removed // 0' "$sidecar")

  age="?"
  idle="?"
  if [ "$started" != "?" ]; then age=$(format_duration "$started" "$NOW" 2>/dev/null || echo "?"); fi
  if [ "$last" != "?" ]; then idle=$(format_duration "$last" "$NOW" 2>/dev/null || echo "?"); fi

  echo -e "${CYAN}Session${NC} ${DIM}${id:0:12}…${NC}"
  echo -e "  Project:      ${GREEN}${project}${NC}"
  echo -e "  Cwd:          ${DIM}${cwd}${NC}"
  echo -e "  Started:      ${started}  ${DIM}(age: ${age})${NC}"
  echo -e "  Last active:  ${last}  ${DIM}(idle: ${idle})${NC}"
  echo -e "  Prompts:      ${prompts}"
  echo -e "  Lessons:      ${lessons}"
  echo -e "  Files:        ${files}"
  cost_fmt=$(LC_NUMERIC=C awk -v c="$cost" 'BEGIN{printf "$%.4f", c}')
  dur_fmt=$(LC_NUMERIC=C awk -v d="$dur_ms" 'BEGIN{printf "%.1fs", d/1000}')
  echo -e "  Cost:         ${GREEN}${cost_fmt}${NC}  ${DIM}(${dur_fmt} API time)${NC}"
  echo -e "  Lines:        ${DIM}+${la} / -${lr}${NC}"

  # Soft checkpoint hints
  if [ "$prompts" -ge 30 ] && [ "$lessons" -eq 0 ]; then
    echo -e "  ${YELLOW}⚠ ${prompts} prompts without a lesson captured${NC}"
  fi
  echo ""
done
