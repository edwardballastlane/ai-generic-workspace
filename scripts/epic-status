#!/usr/bin/env bash

# epic-status - Display and update Jira epic progress with context preservation
# Usage: ./scripts/epic-status <EPIC-KEY> [options]
#
# Options:
#   --update <TASK>=completed   Mark a task as completed
#   --notes "text"              Add completion notes (use with --update)
#   --next                      Show only the next ready task
#   --graph                     Show dependency graph
#   --resume                    Generate full resume context for new conversations

set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT_DIR="$(dirname "$SCRIPT_DIR")"
CONTEXTS_DIR="$ROOT_DIR/.ai-contexts"

# Colors
GREEN='\033[0;32m'
BLUE='\033[0;34m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
CYAN='\033[0;36m'
GRAY='\033[0;90m'
NC='\033[0m'
BOLD='\033[1m'

# Parse arguments
EPIC_KEY=""
UPDATE_TASK=""
UPDATE_STATUS=""
COMPLETION_NOTES=""
SHOW_NEXT=false
SHOW_GRAPH=false
SHOW_RESUME=false

while [[ $# -gt 0 ]]; do
    case $1 in
        --update)
            IFS='=' read -r UPDATE_TASK UPDATE_STATUS <<< "$2"
            shift 2
            ;;
        --notes)
            COMPLETION_NOTES="$2"
            shift 2
            ;;
        --next)
            SHOW_NEXT=true
            shift
            ;;
        --graph)
            SHOW_GRAPH=true
            shift
            ;;
        --resume)
            SHOW_RESUME=true
            shift
            ;;
        -h|--help)
            echo "Usage: ./scripts/epic-status <EPIC-KEY> [options]"
            echo ""
            echo "Options:"
            echo "  --update <TASK>=completed   Mark a task as completed"
            echo "  --notes \"text\"              Add completion notes (use with --update)"
            echo "  --next                      Show only the next ready task"
            echo "  --graph                     Show dependency graph"
            echo "  --resume                    Generate full resume context for new conversations"
            echo ""
            echo "Examples:"
            echo "  ./scripts/epic-status PROJ-100"
            echo "  ./scripts/epic-status PROJ-100 --update PROJ-1234=completed --notes \"Added schema fields\""
            echo "  ./scripts/epic-status PROJ-100 --resume"
            exit 0
            ;;
        *)
            if [ -z "$EPIC_KEY" ]; then
                EPIC_KEY="$1"
            fi
            shift
            ;;
    esac
done

if [ -z "$EPIC_KEY" ]; then
    echo -e "${RED}Error: Epic key required${NC}"
    echo "Usage: ./scripts/epic-status <EPIC-KEY>"
    exit 1
fi

CONTEXT_FILE="$CONTEXTS_DIR/epic-${EPIC_KEY}.yaml"

if [ ! -f "$CONTEXT_FILE" ]; then
    echo -e "${RED}Error: Epic context not found${NC}"
    echo "File not found: $CONTEXT_FILE"
    echo ""
    echo "Run /jira-epic $EPIC_KEY to generate the context file."
    exit 1
fi

# Function to read YAML value (simple parser)
yaml_get() {
    local file="$1"
    local key="$2"
    grep "^${key}:" "$file" 2>/dev/null | sed "s/^${key}: *//" | tr -d '"' || echo ""
}

# Function to get task property
task_get() {
    local file="$1"
    local task="$2"
    local prop="$3"
    # Use grep -A to get lines after task key, then find property
    grep -A20 "^  ${task}:" "$file" 2>/dev/null | grep "^    ${prop}:" | head -1 | sed "s/^    ${prop}: *//" | tr -d '"[]' || echo ""
}

# Function to list all task keys
list_tasks() {
    local file="$1"
    awk '/^tasks:$/,/^dependency_graph:$/' "$file" | grep '^  [A-Z]' | sed 's/: *$//' | tr -d ' '
}

# Function to update work_status in context file
update_task_status() {
    local task="$1"
    local status="$2"
    local notes="$3"

    if [ "$status" = "completed" ]; then
        local timestamp
        timestamp="$(date -u +%Y-%m-%dT%H:%M:%SZ)"

        # Update generated timestamp in epic file
        sed -i.bak "s/^generated: .*/generated: \"$timestamp\"/" "$CONTEXT_FILE"
        rm -f "$CONTEXT_FILE.bak"

        # Update work_status to completed using perl for multiline support
        if [ -n "$notes" ]; then
            local escaped_notes
            escaped_notes=$(echo "$notes" | sed 's/"/\\"/g')
            perl -i -p0e "s/(  ${task}:.*?work_status: )\"[^\"]*\"/\${1}\"completed\"\n    completed_at: \"${timestamp}\"\n    completion_notes: \"${escaped_notes}\"/s" "$CONTEXT_FILE"
        else
            perl -i -p0e "s/(  ${task}:.*?work_status: )\"[^\"]*\"/\${1}\"completed\"\n    completed_at: \"${timestamp}\"/s" "$CONTEXT_FILE"
        fi

        # Also update individual task file if it exists
        local task_file="$CONTEXTS_DIR/tasks/${task}.yaml"
        if [ -f "$task_file" ]; then
            # Update completed_at
            if grep -q "^completed_at:" "$task_file"; then
                sed -i.bak "s/^completed_at:.*/completed_at: \"$timestamp\"/" "$task_file"
            else
                echo "completed_at: \"$timestamp\"" >> "$task_file"
            fi
            # Update completion_notes
            if [ -n "$notes" ]; then
                local escaped_notes
                escaped_notes=$(echo "$notes" | sed 's/"/\\"/g')
                if grep -q "^completion_notes:" "$task_file"; then
                    sed -i.bak "s/^completion_notes:.*/completion_notes: \"$escaped_notes\"/" "$task_file"
                else
                    echo "completion_notes: \"$escaped_notes\"" >> "$task_file"
                fi
            fi
            rm -f "$task_file.bak"
        fi

        echo -e "${GREEN}Task $task marked as completed${NC}"
        if [ -n "$notes" ]; then
            echo -e "${GRAY}Notes: $notes${NC}"
        fi

        # Check if this unblocks other tasks
        recalculate_work_status
    fi
}

# Function to recalculate work_status for all tasks
recalculate_work_status() {
    local tasks
    tasks=$(list_tasks "$CONTEXT_FILE")

    for task in $tasks; do
        local blocked_by
        local work_status
        blocked_by=$(task_get "$CONTEXT_FILE" "$task" "blocked_by")
        work_status=$(task_get "$CONTEXT_FILE" "$task" "work_status")

        # Skip if already completed
        if [ "$work_status" = "completed" ]; then
            continue
        fi

        # Check if all blockers are completed
        local all_blockers_done=true
        if [ -n "$blocked_by" ]; then
            IFS=', ' read -ra BLOCKERS <<< "$blocked_by"
            for blocker in "${BLOCKERS[@]}"; do
                blocker=$(echo "$blocker" | tr -d ' ')
                if [ -n "$blocker" ]; then
                    local blocker_status
                    blocker_status=$(task_get "$CONTEXT_FILE" "$blocker" "work_status")
                    if [ "$blocker_status" != "completed" ]; then
                        all_blockers_done=false
                        break
                    fi
                fi
            done
        fi

        if $all_blockers_done && [ "$work_status" = "blocked" ]; then
            # Update to ready using perl for reliability
            perl -i -p0e "s/(  ${task}:.*?work_status: )\"blocked\"/\${1}\"ready\"/s" "$CONTEXT_FILE"
            echo -e "${CYAN}Task $task is now ready (unblocked)${NC}"
        fi
    done
}

# Handle update if requested
if [ -n "$UPDATE_TASK" ] && [ -n "$UPDATE_STATUS" ]; then
    update_task_status "$UPDATE_TASK" "$UPDATE_STATUS" "$COMPLETION_NOTES"
    echo ""
fi

# Read epic info
EPIC_SUMMARY=$(yaml_get "$CONTEXT_FILE" "  summary" | head -1)
PROJECT_NAME=$(yaml_get "$CONTEXT_FILE" "  name" | head -1)
BASE_BRANCH=$(yaml_get "$CONTEXT_FILE" "  base_branch" | head -1)

# Collect tasks by status
READY_TASKS=()
BLOCKED_TASKS=()
COMPLETED_TASKS=()

tasks=$(list_tasks "$CONTEXT_FILE")
for task in $tasks; do
    work_status=$(task_get "$CONTEXT_FILE" "$task" "work_status")
    case "$work_status" in
        ready)
            READY_TASKS+=("$task")
            ;;
        blocked)
            BLOCKED_TASKS+=("$task")
            ;;
        completed)
            COMPLETED_TASKS+=("$task")
            ;;
    esac
done

TOTAL_TASKS=$((${#READY_TASKS[@]} + ${#BLOCKED_TASKS[@]} + ${#COMPLETED_TASKS[@]}))
COMPLETED_COUNT=${#COMPLETED_TASKS[@]}

# Show next task only
if $SHOW_NEXT; then
    if [ ${#READY_TASKS[@]} -gt 0 ]; then
        next_task="${READY_TASKS[0]}"
        summary=$(task_get "$CONTEXT_FILE" "$next_task" "summary")
        pr_target=$(task_get "$CONTEXT_FILE" "$next_task" "pr_target")
        layer=$(task_get "$CONTEXT_FILE" "$next_task" "layer")
        echo -e "${GREEN}Next ready task:${NC}"
        echo -e "${BOLD}$next_task${NC}: $summary [Layer $layer]"
        echo ""
        echo "/work-ticket \"$next_task: $summary\" --branch $next_task --target $pr_target --epic $EPIC_KEY"
    else
        echo -e "${YELLOW}No ready tasks. All tasks are either completed or blocked.${NC}"
    fi
    exit 0
fi

# Show dependency graph only
if $SHOW_GRAPH; then
    echo -e "${BOLD}Dependency Graph: $EPIC_KEY${NC}"
    echo ""

    # Find root tasks (no blockers)
    for task in $tasks; do
        blocked_by=$(task_get "$CONTEXT_FILE" "$task" "blocked_by")
        work_status=$(task_get "$CONTEXT_FILE" "$task" "work_status")

        if [ -z "$blocked_by" ]; then
            # This is a root task
            case "$work_status" in
                ready)     status_icon="${GREEN}◯${NC}" ;;
                blocked)   status_icon="${YELLOW}◯${NC}" ;;
                completed) status_icon="${GREEN}●${NC}" ;;
            esac
            echo -e "$status_icon $task"

            # Find tasks blocked by this one
            for child in $tasks; do
                child_blocked_by=$(task_get "$CONTEXT_FILE" "$child" "blocked_by")
                if [[ "$child_blocked_by" == *"$task"* ]]; then
                    child_status=$(task_get "$CONTEXT_FILE" "$child" "work_status")
                    case "$child_status" in
                        ready)     child_icon="${GREEN}◯${NC}" ;;
                        blocked)   child_icon="${YELLOW}◯${NC}" ;;
                        completed) child_icon="${GREEN}●${NC}" ;;
                    esac
                    echo -e "  └── $child_icon $child"

                    # Find grandchildren
                    for grandchild in $tasks; do
                        grandchild_blocked_by=$(task_get "$CONTEXT_FILE" "$grandchild" "blocked_by")
                        if [[ "$grandchild_blocked_by" == *"$child"* ]]; then
                            grandchild_status=$(task_get "$CONTEXT_FILE" "$grandchild" "work_status")
                            case "$grandchild_status" in
                                ready)     gc_icon="${GREEN}◯${NC}" ;;
                                blocked)   gc_icon="${YELLOW}◯${NC}" ;;
                                completed) gc_icon="${GREEN}●${NC}" ;;
                            esac
                            echo -e "      └── $gc_icon $grandchild"
                        fi
                    done
                fi
            done
        fi
    done
    echo ""
    echo -e "Legend: ${GREEN}●${NC} completed  ${GREEN}◯${NC} ready  ${YELLOW}◯${NC} blocked"
    exit 0
fi

# Show resume context for new conversations
if $SHOW_RESUME; then
    echo "=== PASTE THIS INTO NEW CONVERSATION TO RESUME ==="
    echo ""
    echo "EPIC_CONTEXT_START"
    echo "epic: $EPIC_KEY"
    echo "summary: $EPIC_SUMMARY"
    echo "project: $PROJECT_NAME"
    echo "base_branch: $BASE_BRANCH"
    echo "progress: $COMPLETED_COUNT/$TOTAL_TASKS tasks complete"
    echo "context_file: .ai-contexts/epic-${EPIC_KEY}.yaml"
    echo ""

    # Completed tasks with notes
    if [ ${#COMPLETED_TASKS[@]} -gt 0 ]; then
        echo "## COMPLETED WORK (context for continuity)"
        for task in "${COMPLETED_TASKS[@]}"; do
            summary=$(task_get "$CONTEXT_FILE" "$task" "summary")
            completed_at=$(task_get "$CONTEXT_FILE" "$task" "completed_at")
            notes=$(task_get "$CONTEXT_FILE" "$task" "completion_notes")
            pr_target=$(task_get "$CONTEXT_FILE" "$task" "pr_target")
            echo "- $task: $summary"
            echo "  PR: $task -> $pr_target (MERGED)"
            if [ -n "$notes" ]; then
                echo "  Done: $notes"
            fi
            if [ -n "$completed_at" ]; then
                echo "  Completed: $completed_at"
            fi
            echo ""
        done
    fi

    # Ready tasks
    if [ ${#READY_TASKS[@]} -gt 0 ]; then
        echo "## READY TASKS (work these now)"
        for task in "${READY_TASKS[@]}"; do
            summary=$(task_get "$CONTEXT_FILE" "$task" "summary")
            pr_target=$(task_get "$CONTEXT_FILE" "$task" "pr_target")
            layer=$(task_get "$CONTEXT_FILE" "$task" "layer")
            echo "- $task: $summary [Layer $layer]"
            echo "  /work-ticket \"$task: $summary\" --branch $task --target $pr_target --epic $EPIC_KEY"
            echo ""
        done
    fi

    # Blocked tasks
    if [ ${#BLOCKED_TASKS[@]} -gt 0 ]; then
        echo "## BLOCKED TASKS (waiting on dependencies)"
        for task in "${BLOCKED_TASKS[@]}"; do
            summary=$(task_get "$CONTEXT_FILE" "$task" "summary")
            blocked_by=$(task_get "$CONTEXT_FILE" "$task" "blocked_by")
            pr_target=$(task_get "$CONTEXT_FILE" "$task" "pr_target")
            layer=$(task_get "$CONTEXT_FILE" "$task" "layer")
            echo "- $task: $summary [Layer $layer, blocked by: $blocked_by]"
            echo "  /work-ticket \"$task: $summary\" --branch $task --target $pr_target --epic $EPIC_KEY"
            echo ""
        done
    fi

    echo "EPIC_CONTEXT_END"
    echo ""
    echo "=== END OF RESUME CONTEXT ==="
    exit 0
fi

# Full status display
echo -e "${BOLD}Epic: $EPIC_KEY${NC}"
echo -e "${GRAY}$EPIC_SUMMARY${NC}"
echo ""
echo -e "Project: ${CYAN}$PROJECT_NAME${NC}  Base: ${CYAN}$BASE_BRANCH${NC}"
echo -e "Progress: ${GREEN}$COMPLETED_COUNT${NC}/$TOTAL_TASKS tasks complete"
echo ""

# Completed tasks (show what was done)
if [ ${#COMPLETED_TASKS[@]} -gt 0 ]; then
    echo -e "${GREEN}${BOLD}Completed Tasks${NC}"
    for task in "${COMPLETED_TASKS[@]}"; do
        summary=$(task_get "$CONTEXT_FILE" "$task" "summary")
        notes=$(task_get "$CONTEXT_FILE" "$task" "completion_notes")
        echo -e "  ${GREEN}●${NC} ${BOLD}$task${NC}: $summary"
        if [ -n "$notes" ]; then
            echo -e "    ${GRAY}→ $notes${NC}"
        fi
    done
    echo ""
fi

# Ready tasks
if [ ${#READY_TASKS[@]} -gt 0 ]; then
    echo -e "${GREEN}${BOLD}Ready Tasks${NC} (work these now)"
    for task in "${READY_TASKS[@]}"; do
        summary=$(task_get "$CONTEXT_FILE" "$task" "summary")
        pr_target=$(task_get "$CONTEXT_FILE" "$task" "pr_target")
        layer=$(task_get "$CONTEXT_FILE" "$task" "layer")
        echo -e "  ${GREEN}◯${NC} ${BOLD}$task${NC}: $summary [L$layer]"
        echo -e "    ${GRAY}/work-ticket \"$task: $summary\" --branch $task --target $pr_target --epic $EPIC_KEY${NC}"
    done
    echo ""
fi

# Blocked tasks
if [ ${#BLOCKED_TASKS[@]} -gt 0 ]; then
    echo -e "${YELLOW}${BOLD}Blocked Tasks${NC} (waiting on dependencies)"
    for task in "${BLOCKED_TASKS[@]}"; do
        summary=$(task_get "$CONTEXT_FILE" "$task" "summary")
        blocked_by=$(task_get "$CONTEXT_FILE" "$task" "blocked_by")
        layer=$(task_get "$CONTEXT_FILE" "$task" "layer")
        echo -e "  ${YELLOW}◯${NC} ${BOLD}$task${NC}: $summary [L$layer]"
        echo -e "    ${GRAY}blocked by: $blocked_by${NC}"
    done
    echo ""
fi

# Quick commands
echo -e "${BLUE}${BOLD}Quick Commands${NC}"
echo "  Resume context:  ./scripts/epic-status $EPIC_KEY --resume"
echo "  Next task:       ./scripts/epic-status $EPIC_KEY --next"
echo "  Complete task:   ./scripts/epic-status $EPIC_KEY --update <TASK>=completed --notes \"what was done\""
