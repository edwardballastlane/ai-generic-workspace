#!/usr/bin/env bash

# Check if setup has been completed
# Source this script or run it to verify setup status

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT_DIR="$(dirname "$SCRIPT_DIR")"
CONFIG_FILE="$ROOT_DIR/.ai-config/settings.yaml"

# Colors
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
GREEN='\033[0;32m'
NC='\033[0m'

# Function to check setup
check_setup() {
    if [ ! -f "$CONFIG_FILE" ]; then
        echo ""
        echo -e "${YELLOW}╔══════════════════════════════════════════════════════╗${NC}"
        echo -e "${YELLOW}║  Setup Required                                      ║${NC}"
        echo -e "${YELLOW}╚══════════════════════════════════════════════════════╝${NC}"
        echo ""
        echo -e "  Welcome to Lane!"
        echo ""
        echo -e "  Before you start, please run the setup script:"
        echo ""
        echo -e "    ${GREEN}./scripts/setup${NC}"
        echo ""
        echo -e "  This will configure:"
        echo -e "    - Git platform (GitHub, Bitbucket, GitLab, etc.)"
        echo -e "    - Default branch for PRs"
        echo -e "    - Workspace structure"
        echo -e "    - Your first project"
        echo ""
        return 1
    fi
    return 0
}

# Function to get config value
get_config() {
    local key="$1"
    if [ -f "$CONFIG_FILE" ]; then
        grep "^  $key:" "$CONFIG_FILE" 2>/dev/null | head -1 | awk '{print $2}' | tr -d '"'
    fi
}

# Function to get git platform
get_git_platform() {
    get_config "platform"
}

# Function to get default branch
get_default_branch() {
    get_config "default_branch"
}

# Function to get git CLI
get_git_cli() {
    get_config "cli"
}

# If run directly (not sourced), perform check
if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    if ! check_setup; then
        exit 1
    fi
    echo -e "${GREEN}✓${NC} Setup completed. Configuration: $CONFIG_FILE"
    echo ""
    echo "Git Platform: $(get_git_platform)"
    echo "Default Branch: $(get_default_branch)"
    echo "Git CLI: $(get_git_cli)"
fi
