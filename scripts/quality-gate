#!/usr/bin/env bash
# quality-gate — Unified quality gate runner
#
# Single entry point for all quality validation across stages.
# Runs progressively more checks depending on the stage.
#
# Usage:
#   ./scripts/quality-gate <project> --stage pre-commit
#   ./scripts/quality-gate <project> --stage pre-pr
#   ./scripts/quality-gate <project> --stage ci

set -uo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT_DIR="$(dirname "$SCRIPT_DIR")"
SNAPSHOT_DIR="$ROOT_DIR/.ai-session/snapshots"

# Colors
GREEN='\033[0;32m'
RED='\033[0;31m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
BOLD='\033[1m'
DIM='\033[2m'
NC='\033[0m'

# Counters
PASS_COUNT=0
FAIL_COUNT=0
WARN_COUNT=0

# ── Helpers ──────────────────────────────────────────────────────────────────

usage() {
  echo "Usage: ./scripts/quality-gate <project> --stage <pre-commit|pre-pr|ci>"
  echo ""
  echo "Arguments:"
  echo "  project    Project name (resolves via agent/_projects/<project>)"
  echo ""
  echo "Options:"
  echo "  --stage    Stage to run: pre-commit, pre-pr, ci"
  echo ""
  echo "Examples:"
  echo "  ./scripts/quality-gate my-app --stage pre-commit"
  echo "  ./scripts/quality-gate my-app --stage pre-pr"
  echo "  ./scripts/quality-gate my-app --stage ci"
  exit 1
}

resolve_project() {
  local project="$1"
  local project_path="$ROOT_DIR/agent/_projects/$project"

  if [ -L "$project_path" ]; then
    readlink -f "$project_path"
  elif [ -d "$project_path" ]; then
    echo "$project_path"
  else
    echo ""
  fi
}

pass() {
  echo -e "${GREEN}✓${NC} $1"
  PASS_COUNT=$((PASS_COUNT + 1))
}

fail() {
  echo -e "${RED}✗${NC} $1"
  FAIL_COUNT=$((FAIL_COUNT + 1))
}

warn() {
  echo -e "${YELLOW}⚠${NC} $1"
  WARN_COUNT=$((WARN_COUNT + 1))
}

# ── Checks ───────────────────────────────────────────────────────────────────

check_secrets() {
  local project_path="$1"

  local secret_patterns='(AKIA[0-9A-Z]{16}|sk-[a-zA-Z0-9]{20,}|password\s*[:=]\s*["\x27][^"\x27]{6,}|api[_-]?key\s*[:=]\s*["\x27][^"\x27]{6,}|token\s*[:=]\s*["\x27][^"\x27]{6,}|secret\s*[:=]\s*["\x27][^"\x27]{6,}|-----BEGIN (RSA |EC |DSA )?PRIVATE KEY-----)'

  local matches
  matches=$(grep -rEn "$secret_patterns" "$project_path" \
    --include="*.ts" --include="*.js" --include="*.tsx" --include="*.jsx" \
    --include="*.py" --include="*.rb" --include="*.go" --include="*.java" \
    --include="*.json" --include="*.yaml" --include="*.yml" --include="*.env" \
    --include="*.toml" --include="*.cfg" --include="*.ini" \
    --exclude-dir=node_modules --exclude-dir=.git --exclude-dir=dist \
    --exclude-dir=build --exclude-dir=coverage --exclude-dir=.next \
    --exclude-dir=.venv --exclude-dir=venv --exclude-dir=__pycache__ \
    --exclude="*.lock" --exclude="package-lock.json" \
    2>/dev/null || true)

  if [ -n "$matches" ]; then
    fail "Potential secrets detected:"
    echo "$matches" | head -10 | sed 's/^/    /'
    local count
    count=$(echo "$matches" | wc -l)
    if [ "$count" -gt 10 ]; then
      echo "    ... and $((count - 10)) more"
    fi
    return 1
  else
    pass "No secrets detected"
    return 0
  fi
}

check_lint() {
  local project_path="$1"

  if [ ! -f "$project_path/package.json" ]; then
    warn "No package.json found — skipping lint"
    return 0
  fi

  # Detect lint command from package.json
  local lint_cmd=""
  if grep -q '"lint"' "$project_path/package.json" 2>/dev/null; then
    lint_cmd="npm run lint"
  elif grep -q '"eslint"' "$project_path/package.json" 2>/dev/null; then
    lint_cmd="npx eslint ."
  fi

  if [ -z "$lint_cmd" ]; then
    warn "No lint script found in package.json — skipping lint"
    return 0
  fi

  local lint_output
  if lint_output=$(cd "$project_path" && $lint_cmd 2>&1); then
    pass "Lint passes"
    return 0
  else
    fail "Lint failed"
    echo "$lint_output" | tail -10 | sed 's/^/    /'
    return 1
  fi
}

check_typecheck() {
  local project_path="$1"

  # Check if this is a TypeScript project
  if [ ! -f "$project_path/tsconfig.json" ]; then
    return 0
  fi

  local tsc_cmd=""
  if [ -f "$project_path/package.json" ] && grep -q '"typecheck"' "$project_path/package.json" 2>/dev/null; then
    tsc_cmd="npm run typecheck"
  elif [ -f "$project_path/package.json" ] && grep -q '"type-check"' "$project_path/package.json" 2>/dev/null; then
    tsc_cmd="npm run type-check"
  elif [ -f "$project_path/node_modules/.bin/tsc" ]; then
    tsc_cmd="npx tsc --noEmit"
  elif command -v tsc &> /dev/null; then
    tsc_cmd="tsc --noEmit"
  else
    warn "TypeScript project but tsc not available — skipping type check"
    return 0
  fi

  local tsc_output
  if tsc_output=$(cd "$project_path" && $tsc_cmd 2>&1); then
    pass "Type check passes"
    return 0
  else
    fail "Type check failed"
    echo "$tsc_output" | tail -10 | sed 's/^/    /'
    return 1
  fi
}

check_tests() {
  local project_path="$1"

  if [ ! -f "$project_path/package.json" ]; then
    warn "No package.json found — skipping tests"
    return 0
  fi

  local test_cmd=""
  if grep -q '"test"' "$project_path/package.json" 2>/dev/null; then
    # Verify test script is not the default npm placeholder
    local test_script
    test_script=$(cd "$project_path" && node -e "console.log(require('./package.json').scripts?.test || '')" 2>/dev/null)
    if [ -n "$test_script" ] && ! echo "$test_script" | grep -q "no test specified"; then
      test_cmd="npm test"
    fi
  fi

  if [ -z "$test_cmd" ]; then
    warn "No test script found — skipping tests"
    return 0
  fi

  local test_output
  if test_output=$(cd "$project_path" && $test_cmd 2>&1); then
    # Try to extract test count from output
    local test_summary
    test_summary=$(echo "$test_output" | grep -oP '\d+ (passing|passed|tests?)' | head -1)
    if [ -n "$test_summary" ]; then
      pass "Tests pass ($test_summary)"
    else
      pass "Tests pass"
    fi
    return 0
  else
    fail "Tests failed"
    echo "$test_output" | tail -15 | sed 's/^/    /'
    return 1
  fi
}

check_coverage() {
  local project_path="$1"
  local threshold="${2:-70}"

  if [ ! -f "$project_path/package.json" ]; then
    return 0
  fi

  # Check for coverage configuration
  local has_coverage=false
  if [ -f "$project_path/.nycrc" ] || [ -f "$project_path/.nycrc.json" ]; then
    has_coverage=true
  elif [ -f "$project_path/jest.config.js" ] || [ -f "$project_path/jest.config.ts" ]; then
    has_coverage=true
  elif grep -q "coverageDirectory\|collectCoverage\|c8\|nyc\|istanbul" "$project_path/package.json" 2>/dev/null; then
    has_coverage=true
  fi

  if [ "$has_coverage" = false ]; then
    warn "No coverage tool configured — skipping coverage check"
    return 0
  fi

  # Look for coverage summary from the test run
  local coverage_file=""
  for candidate in \
    "$project_path/coverage/coverage-summary.json" \
    "$project_path/coverage/coverage-final.json"; do
    if [ -f "$candidate" ]; then
      coverage_file="$candidate"
      break
    fi
  done

  if [ -z "$coverage_file" ]; then
    warn "No coverage report found — run tests with coverage first"
    return 0
  fi

  local pct
  pct=$(python3 -c "
import json, sys
with open('$coverage_file') as f:
    data = json.load(f)
total = data.get('total', {})
lines = total.get('lines', total.get('statements', {}))
pct = lines.get('pct', 0)
print(int(pct))
" 2>/dev/null || echo "0")

  if [ "$pct" -ge "$threshold" ]; then
    pass "Coverage: ${pct}% (threshold: ${threshold}%)"
    return 0
  else
    warn "Coverage: ${pct}% (threshold: ${threshold}%) — WARNING"
    return 0  # Warnings don't fail
  fi
}

check_snapshot_comparison() {
  local project="$1"

  local before_file="$SNAPSHOT_DIR/${project}-before.json"
  if [ ! -f "$before_file" ]; then
    return 0
  fi

  pass "Snapshot baseline found — run ./scripts/snapshot-after $project for full comparison"
  return 0
}

check_ai_review_reminder() {
  warn "Remember to use a DIFFERENT AI role for review"
  return 0
}

check_sonarqube() {
  local project_path="$1"

  if [ ! -f "$project_path/sonar-project.properties" ]; then
    return 0
  fi

  if ! command -v sonar-scanner &> /dev/null; then
    warn "SonarQube config found but sonar-scanner not installed — skipping"
    return 0
  fi

  local sonar_output
  if sonar_output=$(cd "$project_path" && sonar-scanner 2>&1); then
    pass "SonarQube analysis passes"
    return 0
  else
    fail "SonarQube analysis failed"
    echo "$sonar_output" | tail -10 | sed 's/^/    /'
    return 1
  fi
}

check_dependency_audit() {
  local project_path="$1"

  if [ ! -f "$project_path/package.json" ]; then
    return 0
  fi

  if [ ! -f "$project_path/package-lock.json" ] && [ ! -f "$project_path/yarn.lock" ]; then
    warn "No lockfile found — skipping dependency audit"
    return 0
  fi

  local audit_output
  if audit_output=$(cd "$project_path" && npm audit --audit-level=high 2>&1); then
    pass "Dependency audit passes (no high/critical vulnerabilities)"
    return 0
  else
    local vuln_count
    vuln_count=$(echo "$audit_output" | grep -oP '\d+ vulnerabilit' | grep -oP '\d+' | head -1 || echo "unknown")
    fail "Dependency audit: $vuln_count vulnerabilities found at high/critical level"
    echo "$audit_output" | grep -E "high|critical" | head -5 | sed 's/^/    /'
    return 1
  fi
}

check_build() {
  local project_path="$1"

  if [ ! -f "$project_path/package.json" ]; then
    warn "No package.json found — skipping build"
    return 0
  fi

  if ! grep -q '"build"' "$project_path/package.json" 2>/dev/null; then
    warn "No build script found — skipping build"
    return 0
  fi

  local build_output
  if build_output=$(cd "$project_path" && npm run build 2>&1); then
    pass "Build succeeds"
    return 0
  else
    fail "Build failed"
    echo "$build_output" | tail -15 | sed 's/^/    /'
    return 1
  fi
}

# ── Main ─────────────────────────────────────────────────────────────────────

# Parse arguments
PROJECT=""
STAGE=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    --stage)
      STAGE="${2:-}"
      shift 2
      ;;
    --help|-h)
      usage
      ;;
    *)
      if [ -z "$PROJECT" ]; then
        PROJECT="$1"
      else
        echo "Unexpected argument: $1"
        usage
      fi
      shift
      ;;
  esac
done

if [ -z "$PROJECT" ] || [ -z "$STAGE" ]; then
  usage
fi

# Validate stage
case "$STAGE" in
  pre-commit|pre-pr|ci) ;;
  *)
    echo "Invalid stage: $STAGE"
    echo "Valid stages: pre-commit, pre-pr, ci"
    exit 1
    ;;
esac

# Resolve project
PROJECT_PATH=$(resolve_project "$PROJECT")
if [ -z "$PROJECT_PATH" ] || [ ! -d "$PROJECT_PATH" ]; then
  echo -e "${RED}Project not found: $PROJECT${NC}"
  echo ""
  echo "Available projects:"
  ls "$ROOT_DIR/agent/_projects/" 2>/dev/null | grep -v .gitkeep | sed 's/^/  /'
  exit 1
fi

echo -e "${BLUE}${BOLD}=== Quality Gate: $PROJECT ($STAGE) ===${NC}"
echo ""

# ── Stage: pre-commit ───────────────────────────────────────────────────────

check_secrets "$PROJECT_PATH" || true
check_lint "$PROJECT_PATH" || true
check_typecheck "$PROJECT_PATH" || true

# ── Stage: pre-pr (includes pre-commit) ─────────────────────────────────────

if [ "$STAGE" = "pre-pr" ] || [ "$STAGE" = "ci" ]; then
  check_tests "$PROJECT_PATH" || true
  check_coverage "$PROJECT_PATH" 70 || true
  check_ai_review_reminder
  check_snapshot_comparison "$PROJECT" || true
fi

# ── Stage: ci (includes pre-pr) ─────────────────────────────────────────────

if [ "$STAGE" = "ci" ]; then
  check_sonarqube "$PROJECT_PATH" || true
  check_dependency_audit "$PROJECT_PATH" || true
  check_build "$PROJECT_PATH" || true
fi

# ── Summary ──────────────────────────────────────────────────────────────────

echo ""
echo -e "${DIM}━━━━━━━━━━━━━━━━━━━━${NC}"

TOTAL=$((PASS_COUNT + FAIL_COUNT + WARN_COUNT))

if [ "$FAIL_COUNT" -gt 0 ]; then
  echo -e "${RED}${BOLD}Result: FAIL${NC} ($FAIL_COUNT failure(s), $WARN_COUNT warning(s), $PASS_COUNT passed)"
  exit 1
else
  local_warning_msg=""
  if [ "$WARN_COUNT" -gt 0 ]; then
    local_warning_msg=" ($WARN_COUNT warning(s))"
  fi
  echo -e "${GREEN}${BOLD}Result: PASS${NC}${local_warning_msg}"
  exit 0
fi
