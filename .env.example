# Lane workspace environment variables.
# Copy to `.env` (chmod 600) and fill in the values you need. Anything left
# blank is simply ignored — set only the keys you actually use.

# ─── Workspace identity ──────────────────────────────────────────────────
# Used to extract Jira ticket IDs (e.g. PROJ-1234) from prompts and commit
# messages. Leave blank to disable Jira ticket extraction entirely.
JIRA_PREFIX=
# Used as a prefix for AWS resources created by infra/token-dashboard/setup.js
# (S3 bucket, CloudFront OAC). Lowercase + [a-z0-9-] only.
WORKSPACE_NAME=

# ─── Atlassian (Jira / Confluence) ───────────────────────────────────────
# Required for `/jira-epic` and ticket fetching. Generate a token at:
# https://id.atlassian.com/manage-profile/security/api-tokens
ATLASSIAN_EMAIL=
ATLASSIAN_API_TOKEN=
# e.g. yourcompany.atlassian.net (no scheme, no trailing slash)
JIRA_HOST=

# ─── Token dashboard (optional, set after running infra/token-dashboard/setup) ───
# Populated by `node infra/token-dashboard/setup.js`; copy from infra/token-dashboard/.env
# if you want `npm run tokens:deploy` to work from the repo root too.
S3_BUCKET=
CLOUDFRONT_DIST_ID=

# ─── AWS credentials (only needed for token-dashboard infra) ─────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# ─── Self-learning (optional) ────────────────────────────────────────────
# Vector backend for the session embedder + `npm run session:search`:
#   qdrant (default) → Qdrant server at QDRANT_URL
#   local            → file store (.claude/vector-store/sessions.json), no server.
#                      Populate it from Qdrant once: npm run session:migrate-to-local
VECTOR_BACKEND=qdrant
# Qdrant URL for semantic rule search and session embedding. Default is the
# docker-compose service shipped in this repo. Point it at a hosted cluster
# (e.g. Qdrant Cloud) to publish live embeddings and let the deployed dashboard
# read them; QDRANT_API_KEY is required by Qdrant Cloud.
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
# Set to 0 to disable the Stop hook's memory-proposal capture.
MEMORY_SYNC_ENABLED=1

# ─── Session event logging (optional) ────────────────────────────────────
# Canonical root for session telemetry. Set this when Claude Code sessions run
# from OTHER repos whose settings point at this workspace's hooks — without it
# each session logs into its own cwd and never reaches the dashboard.
# See docs/specs/spec-2026-06-24-centralized-session-logging.md.
LANE_EVENTS_ROOT=

# ─── Billed-cost reconciliation (optional) ───────────────────────────────
# Anthropic Admin API key (Console → Settings → Admin keys) used by
# `npm run cost:admin` to pull the real metered cost. See docs/reference/cost-accuracy.md.
ANTHROPIC_ADMIN_KEY=

# ─── Bitbucket (optional — sprint-sp-audit / PR effort matching) ──────────
# Workspace slug and the repos the sprint story-point audit searches for PRs.
BITBUCKET_WORKSPACE=
SP_AUDIT_REPOS=
