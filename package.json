{
  "name": "ai-generic-workspace",
  "version": "1.0.0",
  "description": "Generic Claude/Lane phase-based development workspace template (hooks, self-learning, token dashboard).",
  "private": true,
  "dependencies": {
    "@aws-sdk/client-cloudfront": "^3.1044.0",
    "@aws-sdk/client-s3": "^3.1075.0",
    "@aws-sdk/client-sts": "^3.1044.0",
    "@azure/cosmos": "^4.9.0",
    "chalk": "^4.1.2"
  },
  "devDependencies": {
    "@huggingface/transformers": "^3.8.1",
    "@types/node": "^20.11.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "scripts": {
    "self:maintenance": "npx ts-node scripts/self-improvement/maintenance.ts",
    "self:stats": "npx ts-node scripts/self-improvement/reinforcement-tracker.ts stats",
    "self:review": "npx ts-node scripts/self-improvement/proposal-manager.ts review",
    "self:apply": "npx ts-node scripts/self-improvement/proposal-manager.ts apply",
    "self:extract-insights": "npx ts-node scripts/self-improvement/insight-extractor.ts",
    "self:generate-reflections": "npx ts-node scripts/self-improvement/reflection-generator.ts",
    "self:propose-skills": "npx ts-node scripts/self-improvement/skill-generator.ts",
    "self:prune": "npx ts-node scripts/self-improvement/reinforcement-tracker.ts prune",
    "self:consolidate": "npx ts-node scripts/self-improvement/consolidation-engine.ts",
    "self:dashboard": "npx ts-node scripts/session-embedder/dashboard-generator.ts",
    "self:dashboard:publish": "node scripts/self-dashboard-publish.js",
    "self:metrics:backfill": "npx ts-node scripts/session-embedder/self-metrics-backfill.ts",
    "session:embed": "npx ts-node scripts/session-embedder/index.ts embed",
    "session:search": "npx ts-node scripts/session-embedder/search.ts",
    "session:migrate-to-local": "npx ts-node scripts/session-embedder/migrate-to-local.ts",
    "session:stats": "npx ts-node scripts/session-embedder/index.ts stats",
    "tiered:search": "npx ts-node scripts/session-embedder/tiered-search.ts",
    "hybrid:search": "npx ts-node scripts/session-embedder/hybrid-search.ts",
    "session:score": "npx ts-node scripts/session-embedder/quality-scorer.ts",
    "memory:stats": "npx ts-node scripts/shared/agent-memory-scope.ts stats",
    "memory:list": "npx ts-node scripts/shared/agent-memory-scope.ts list",
    "memory:search": "npx ts-node scripts/shared/agent-memory-scope.ts search",
    "memory:transfer": "npx ts-node scripts/shared/agent-memory-scope.ts transfer",
    "memory:review": "npx ts-node scripts/hooks/memory-review.ts",
    "memory:review:list": "npx ts-node scripts/hooks/memory-review.ts --list",
    "memory:review:prune": "npx ts-node scripts/hooks/memory-review.ts --prune 14",
    "memory:mcp": "node scripts/memory-mcp-server.js",
    "memory:setup": "node scripts/memory-setup.js",
    "memory:migrate": "node scripts/memory-migrate.js",
    "memory:migrate:dry": "node scripts/memory-migrate.js --dry-run",
    "memory:export": "node scripts/memory-export.js export",
    "memory:import": "node scripts/memory-export.js import",
    "memory:share": "node scripts/memory-export.js share",
    "memory:board": "node scripts/memory-dashboard.js",
    "memory:prune-noise": "node scripts/memory-prune-noise.js",
    "memory:prune-noise:dry": "node scripts/memory-prune-noise.js --dry-run",
    "memory:stow": "node scripts/memory-stow.js",
    "memory:stow:dry": "node scripts/memory-stow.js --dry-run",
    "evidence:record": "node scripts/record-evidence.js",
    "evidence:verify": "node scripts/verify-evidence.js",
    "verification:record": "node scripts/record-verification.js",
    "verify:gate": "node scripts/verify-gate.js",
    "rules:gate-theater": "node scripts/gate-theater-report.js",
    "ratchet:refusal": "node scripts/refusal-ratchet.js",
    "ratchet:deadcode": "node scripts/deadcode-ratchet.js",
    "ratchet:guard": "node scripts/guard-population.js",
    "ratchet:retired": "node scripts/retired-terms.js",
    "ratchet:all": "node scripts/refusal-ratchet.js && node scripts/deadcode-ratchet.js && node scripts/guard-population.js && node scripts/retired-terms.js",
    "rules:stats": "npx ts-node scripts/self-improvement/effectiveness-stats.ts",
    "rules:stats:json": "npx ts-node scripts/self-improvement/effectiveness-stats.ts --json",
    "rules:promote": "npx ts-node scripts/self-improvement/promote-rules.ts",
    "rules:promote-apply": "npx ts-node scripts/self-improvement/promote-rules.ts --apply",
    "qdrant:seed": "npx ts-node scripts/self-improvement/seed-qdrant.ts",
    "qdrant:status": "npx ts-node scripts/self-improvement/seed-qdrant.ts --status",
    "rules:effectiveness": "npx ts-node scripts/self-improvement/effectiveness-report.ts",
    "rules:sync-to-native": "node scripts/self-improvement/sync-to-native-memory.js",
    "rules:sync-to-native-apply": "node scripts/self-improvement/sync-to-native-memory.js --apply",
    "rules:sync-to-native-clean": "node scripts/self-improvement/sync-to-native-memory.js --clean",
    "tokens:dashboard": "node ./scripts/token-dashboard.js",
    "tokens:data": "node ./scripts/token-dashboard.js --json-only",
    "cost:admin": "node ./scripts/fetch-admin-cost.js",
    "jira:refresh": "node ./scripts/refresh-jira-story-points.js",
    "jira:refresh:force": "node ./scripts/refresh-jira-story-points.js --force",
    "jira:refresh-period": "node ./scripts/refresh-jira-period-tickets.js",
    "jira:refresh-period:force": "node ./scripts/refresh-jira-period-tickets.js --force",
    "tokens:deploy": "node infra/token-dashboard/deploy.js",
    "dashboard:combine": "node scripts/combine-dashboards.js",
    "drift": "node ./scripts/workspace-drift.js",
    "drift:summary": "node ./scripts/workspace-drift.js --summary",
    "drift:scan": "node ./scripts/workspace-drift.js --scan",
    "tokens:setup": "node infra/token-dashboard/setup.js",
    "tokens:teardown": "node infra/token-dashboard/teardown.js",
    "test": "node scripts/run-tests.js",
    "test:watch": "node scripts/run-tests.js --watch",
    "build": "tsc"
  }
}
